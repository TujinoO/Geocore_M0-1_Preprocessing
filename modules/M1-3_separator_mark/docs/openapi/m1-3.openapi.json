{
  "openapi": "3.1.0",
  "info": {
    "title": "Geo-Core AI M1-3 Core Segmentation API",
    "version": "0.1.0",
    "description": "M1-3 岩心柱体分割与深度标记模块前后端分离契约。该契约用于前端生成类型、构建 mock、确认字段与权限行为；其中 preview、segments、corrections、rerun、files 接口为前端页面需要预留的后端实现项。"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "服务状态"
    },
    {
      "name": "DepthMetadata",
      "description": "岩心箱深度元数据"
    },
    {
      "name": "SegmentDepth",
      "description": "M1-3 分割与深度标记任务"
    },
    {
      "name": "Review",
      "description": "前端复核、预览与重跑"
    },
    {
      "name": "Files",
      "description": "产物文件访问"
    }
  ],
  "paths": {
    "/api/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getM13SystemStatus",
        "summary": "查询 M1-3 服务状态",
        "description": "前端进入页面或提交任务前可调用，用于判断算法服务是否可用。不要求业务权限。",
        "security": [],
        "responses": {
          "200": {
            "description": "服务可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                },
                "examples": {
                  "ok": {
                    "$ref": "#/components/examples/SystemStatusOk"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/core-boxes/depth-metadata": {
      "post": {
        "tags": [
          "DepthMetadata"
        ],
        "operationId": "saveM13DepthMetadata",
        "summary": "保存岩心箱深度元数据",
        "description": "保存 M1-3 生成正式 CoreSegment 所需的起止深度、缺失段和深度锚点。前端应在提交分割任务前确保深度信息有效。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.depth_metadata:write"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepthMetadataRequest"
              },
              "examples": {
                "saveDepthMetadata": {
                  "$ref": "#/components/examples/DepthMetadataRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepthMetadataResponse"
                },
                "examples": {
                  "saved": {
                    "$ref": "#/components/examples/DepthMetadataSaved"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/core-boxes/{core_box_id}/depth-metadata": {
      "get": {
        "tags": [
          "DepthMetadata"
        ],
        "operationId": "getM13DepthMetadata",
        "summary": "查询岩心箱深度元数据",
        "description": "进入 M1-3 页面时先查询该接口；404 表示尚未录入深度信息，前端应提示用户补录。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.depth_metadata:read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CoreBoxId"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepthMetadataResponse"
                },
                "examples": {
                  "found": {
                    "$ref": "#/components/examples/DepthMetadataSaved"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth": {
      "post": {
        "tags": [
          "SegmentDepth"
        ],
        "operationId": "submitM13SegmentDepthTask",
        "summary": "提交 M1-3 分割与深度标记任务",
        "description": "基于 M1-1 校正影像、M1-2 掩膜产物和深度信息生成长条岩心、图斑、质量报告。当前实现可同步返回，前端应兼容 pending/running 异步状态。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.task:run"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SegmentDepthRequest"
              },
              "examples": {
                "recommended": {
                  "$ref": "#/components/examples/SegmentDepthRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交或已完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                },
                "examples": {
                  "succeeded": {
                    "$ref": "#/components/examples/TaskSucceeded"
                  },
                  "running": {
                    "$ref": "#/components/examples/TaskRunning"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth/{task_id}": {
      "get": {
        "tags": [
          "SegmentDepth"
        ],
        "operationId": "getM13SegmentDepthTask",
        "summary": "查询 M1-3 任务状态和结果",
        "description": "前端轮询任务状态；成功后读取 output_files、metrics、warnings，并可继续请求 preview 或 segments 分页接口。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.task:read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "任务存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                },
                "examples": {
                  "succeeded": {
                    "$ref": "#/components/examples/TaskSucceeded"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth/{task_id}/segments": {
      "get": {
        "tags": [
          "SegmentDepth"
        ],
        "operationId": "listM13Segments",
        "summary": "分页查询 M1-3 图斑列表",
        "description": "前端图斑表格/网格视图使用。该接口应读取任务产物 segments.json，并返回分页后的 CoreSegment 列表。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.segment:read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "quality_flag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "按质量标记过滤，例如 low_core_coverage 或 contains_missing_interval。"
          }
        ],
        "responses": {
          "200": {
            "description": "图斑分页结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentPage"
                },
                "examples": {
                  "firstPage": {
                    "$ref": "#/components/examples/SegmentPage"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth/{task_id}/preview": {
      "get": {
        "tags": [
          "Review"
        ],
        "operationId": "getM13Preview",
        "summary": "查询前端预览资源",
        "description": "返回结果页所需的图片 URL、质量报告摘要、复核入口数据。正式前后端分离部署时前端应使用 URL，而不是本地绝对路径。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.preview:read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "预览数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                },
                "examples": {
                  "preview": {
                    "$ref": "#/components/examples/PreviewResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth/{task_id}/corrections": {
      "put": {
        "tags": [
          "Review"
        ],
        "operationId": "saveM13Corrections",
        "summary": "保存人工复核修正",
        "description": "保存前端复核时调整的列方向、切分长度、缺失段、深度锚点和备注。该接口只保存修正，不直接重跑。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.review:write"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionRequest"
              },
              "examples": {
                "corrections": {
                  "$ref": "#/components/examples/CorrectionRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/segment-depth/{task_id}/rerun": {
      "post": {
        "tags": [
          "Review"
        ],
        "operationId": "rerunM13SegmentDepthTask",
        "summary": "基于修正结果重跑 M1-3",
        "description": "后端读取原任务输入和已保存 corrections，创建新的 M1-3 任务。前端可用返回的 task_id 跳转到新任务结果页。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.task:run"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "重跑任务已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                },
                "examples": {
                  "running": {
                    "$ref": "#/components/examples/TaskRunning"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "downloadM13File",
        "summary": "访问任务产物文件",
        "description": "将后端保存的任务产物路径映射为可下载响应。后端必须限制 path 只能指向当前用户有权限访问的 M1-3 任务输出目录。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-permissions": [
          "m1_3.file:read"
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "后端任务产物路径或产物 key。不得允许任意系统路径穿透访问。"
          },
          {
            "name": "disposition",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "inline",
                "attachment"
              ],
              "default": "inline"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "文件内容",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "CoreBoxId": {
        "name": "core_box_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "DH001_BOX_0008"
      },
      "TaskId": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "m1_3_20260614_171200_123456"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数或业务校验失败",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "detail": "depth_end_m must be greater than depth_start_m"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或 token 无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "detail": "Authentication credentials were not provided."
            }
          }
        }
      },
      "Forbidden": {
        "description": "已登录但缺少接口所需权限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "detail": "Missing permission: m1_3.task:run"
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在或当前用户不可见",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "detail": "Task was not found."
            }
          }
        }
      }
    },
    "schemas": {
      "SystemStatus": {
        "type": "object",
        "required": [
          "service",
          "module",
          "version",
          "status"
        ],
        "properties": {
          "service": {
            "type": "string",
            "example": "geocore-m1-3"
          },
          "module": {
            "type": "string",
            "example": "M1-3 core segmentation and depth marking"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ]
          }
        }
      },
      "DepthMetadataRequest": {
        "type": "object",
        "required": [
          "hole_id",
          "core_box_id",
          "depth_start_m",
          "depth_end_m"
        ],
        "properties": {
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "hole_id": {
            "type": "string",
            "minLength": 1,
            "description": "钻孔号。"
          },
          "core_box_id": {
            "type": "string",
            "minLength": 1,
            "description": "岩心箱唯一 ID。"
          },
          "box_no": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_no": {
            "type": [
              "string",
              "null"
            ]
          },
          "depth_start_m": {
            "type": "number",
            "description": "岩心箱起始深度，单位 m。"
          },
          "depth_end_m": {
            "type": "number",
            "description": "岩心箱终止深度，单位 m；必须大于 depth_start_m。"
          },
          "missing_intervals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissingInterval"
            },
            "default": []
          },
          "depth_anchors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DepthAnchor"
            },
            "default": []
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DepthMetadataResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DepthMetadataRequest"
          },
          {
            "type": "object",
            "required": [
              "core_box_id",
              "status",
              "updated_at"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "saved"
                ]
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "SegmentDepthRequest": {
        "type": "object",
        "required": [
          "core_box_id",
          "m1_2_output_dir",
          "output_dir",
          "hole_id",
          "depth_start_m",
          "depth_end_m"
        ],
        "properties": {
          "core_box_id": {
            "type": "string",
            "minLength": 1
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "M1-1 校正后岩心箱影像路径；不传时后端可从 M1-2 metadata.json 读取。"
          },
          "m1_2_output_dir": {
            "type": "string",
            "minLength": 1
          },
          "mask_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_dir": {
            "type": "string",
            "minLength": 1
          },
          "hole_id": {
            "type": "string",
            "minLength": 1
          },
          "depth_start_m": {
            "type": "number"
          },
          "depth_end_m": {
            "type": "number"
          },
          "layout": {
            "$ref": "#/components/schemas/LayoutOptions"
          },
          "segmentation": {
            "$ref": "#/components/schemas/SegmentationOptions"
          },
          "mask_refine": {
            "$ref": "#/components/schemas/MaskRefineOptions"
          },
          "reconstruction": {
            "$ref": "#/components/schemas/ReconstructionOptions"
          },
          "depth_mapping": {
            "$ref": "#/components/schemas/DepthMappingOptions"
          },
          "missing_intervals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissingInterval"
            },
            "default": []
          },
          "depth_anchors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DepthAnchor"
            },
            "default": []
          },
          "gap_policy": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "close_artificial_gaps",
              "preserve_all_gaps",
              null
            ]
          }
        }
      },
      "LayoutOptions": {
        "type": "object",
        "properties": {
          "lane_count": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "lane_order": {
            "type": "string",
            "enum": [
              "left_to_right",
              "right_to_left"
            ],
