{
  "openapi": "3.0.3",
  "info": {
    "title": "Geo-Core AI M1-2 Foreground Mask API",
    "version": "1.0.0",
    "description": "M1-2 岩心柱前景掩膜算法模块前后端交互契约。本文档用于前端生成类型、准备 mock 数据、确认字段和权限行为；运行时 FastAPI 自动文档仍可在 /docs 查看。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "本地联调服务"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "系统状态和运行环境"
    },
    {
      "name": "foreground-mask",
      "description": "M1-2 前景掩膜模块级接口"
    },
    {
      "name": "preprocessing",
      "description": "前处理业务流程推荐接口"
    }
  ],
  "paths": {
    "/api/system/status": {
      "get": {
        "tags": ["system"],
        "operationId": "getSystemStatus",
        "summary": "查询算法服务状态",
        "description": "用于前端判断服务是否可用、GPU/CUDA 是否可用以及默认模型配置。 standalone 模式当前不校验登录态；集成到主系统后建议仅允许具备系统诊断或算法使用权限的用户访问。",
        "x-permission": "m1.foregroundMask.read",
        "responses": {
          "200": {
            "description": "服务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                },
                "examples": {
                  "ok": {
                    "$ref": "#/components/examples/SystemStatusOk"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/m1/foreground-mask/models": {
      "get": {
        "tags": ["foreground-mask"],
        "operationId": "listForegroundMaskModels",
        "summary": "查询可用前景掩膜模型",
        "description": "前端用于填充模型配置选择。正式业务界面通常使用 default_profile，不需要暴露模型内部训练参数。",
        "x-permission": "m1.foregroundMask.read",
        "responses": {
          "200": {
            "description": "模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForegroundMaskModelsResponse"
                },
                "examples": {
                  "ok": {
                    "$ref": "#/components/examples/ForegroundMaskModelsOk"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/m1/foreground-mask/jobs": {
      "post": {
        "tags": ["foreground-mask"],
        "operationId": "createForegroundMaskJob",
        "summary": "创建前景掩膜异步任务",
        "description": "基于后端可访问的文件路径或目录创建任务。接口立即返回 task_id，前端应继续轮询状态接口获取结果。",
        "x-permission": "m1.foregroundMask.create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForegroundMaskRequest"
              },
              "examples": {
                "pathInput": {
                  "$ref": "#/components/examples/ForegroundMaskRequestPathInput"
                },
                "directoryInput": {
                  "$ref": "#/components/examples/ForegroundMaskRequestDirectoryInput"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "任务已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCreateResponse"
                },
                "examples": {
                  "created": {
                    "$ref": "#/components/examples/TaskCreated"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/preprocessing/foreground-mask": {
      "post": {
        "tags": ["preprocessing"],
        "operationId": "createPreprocessingForegroundMaskJob",
        "summary": "创建前处理前景掩膜异步任务",
        "description": "推荐给前端正式业务流程使用的创建任务接口，字段结构与 /api/m1/foreground-mask/jobs 一致。",
        "x-permission": "preprocessing.foregroundMask.create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForegroundMaskRequest"
              },
              "examples": {
                "pathInput": {
                  "$ref": "#/components/examples/ForegroundMaskRequestPathInput"
                },
                "directoryInput": {
                  "$ref": "#/components/examples/ForegroundMaskRequestDirectoryInput"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "任务已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCreateResponse"
                },
                "examples": {
                  "created": {
                    "$ref": "#/components/examples/TaskCreated"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/m1/foreground-mask/upload": {
      "post": {
        "tags": ["foreground-mask"],
        "operationId": "uploadForegroundMaskJob",
        "summary": "上传图像并创建前景掩膜任务",
        "description": "用于纯 Web 前端直接上传本地文件。响应仍然是异步任务创建结果，前端继续使用 task_id 轮询状态。",
        "x-permission": "m1.foregroundMask.create",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ForegroundMaskUploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "上传成功并创建任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCreateResponse"
                },
                "examples": {
                  "created": {
                    "$ref": "#/components/examples/TaskCreated"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/m1/foreground-mask/jobs/{task_id}": {
      "get": {
        "tags": ["foreground-mask"],
        "operationId": "getForegroundMaskJob",
        "summary": "查询前景掩膜任务状态",
        "description": "前端应以 500 ms 到 2000 ms 的间隔轮询。status 为 succeeded 后读取 output_files 展示结果；status 为 failed 时展示 error。",
        "x-permission": "m1.foregroundMask.read",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskInfo"
                },
                "examples": {
                  "running": {
                    "$ref": "#/components/examples/TaskRunning"
                  },
                  "succeeded": {
                    "$ref": "#/components/examples/TaskSucceeded"
                  },
                  "failed": {
                    "$ref": "#/components/examples/TaskFailed"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/preprocessing/status/{task_id}": {
      "get": {
        "tags": ["preprocessing"],
        "operationId": "getPreprocessingForegroundMaskStatus",
        "summary": "查询前处理前景掩膜任务状态",
        "description": "推荐给前端正式业务流程使用的状态接口，响应结构与 /api/m1/foreground-mask/jobs/{task_id} 一致。",
        "x-permission": "preprocessing.foregroundMask.read",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskInfo"
                },
                "examples": {
                  "running": {
                    "$ref": "#/components/examples/TaskRunning"
                  },
                  "succeeded": {
                    "$ref": "#/components/examples/TaskSucceeded"
                  },
                  "failed": {
                    "$ref": "#/components/examples/TaskFailed"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/m1/foreground-mask/jobs/{task_id}/mask-edits": {
      "post": {
        "tags": ["foreground-mask"],
        "operationId": "editForegroundMask",
        "summary": "提交人工掩膜编辑",
        "description": "当前仅支持 operation=remove，用于删除误检前景区域。坐标默认是原始图像像素坐标；如果来自缩放画布，需要同时传 display_width 和 display_height。",
        "x-permission": "m1.foregroundMask.edit",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaskEditRequest"
              },
              "examples": {
                "rectangle": {
                  "$ref": "#/components/examples/MaskEditRectangleRequest"
                },
                "mixed": {
                  "$ref": "#/components/examples/MaskEditMixedRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编辑成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaskEditResponse"
                },
                "examples": {
                  "edited": {
                    "$ref": "#/components/examples/MaskEditResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/preprocessing/foreground-mask/{task_id}/mask-edits": {
      "post": {
        "tags": ["preprocessing"],
        "operationId": "editPreprocessingForegroundMask",
        "summary": "提交前处理人工掩膜编辑",
        "description": "推荐给前端正式业务流程使用的掩膜编辑接口，响应结构与模块级接口一致。",
        "x-permission": "preprocessing.foregroundMask.edit",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaskEditRequest"
              },
              "examples": {
                "rectangle": {
                  "$ref": "#/components/examples/MaskEditRectangleRequest"
                },
                "mixed": {
                  "$ref": "#/components/examples/MaskEditMixedRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编辑成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaskEditResponse"
                },
                "examples": {
                  "edited": {
                    "$ref": "#/components/examples/MaskEditResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/m1/foreground-mask/jobs/{task_id}/download": {
      "get": {
        "tags": ["foreground-mask"],
        "operationId": "downloadForegroundMaskResult",
        "summary": "下载任务首个掩膜结果",
        "description": "任务成功后返回 mask_tif 或首个输出文件。前端用于下载场景；图片预览更建议使用 output_files 中的具体路径或后续文件代理接口。",
        "x-permission": "m1.foregroundMask.download",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "文件流",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TaskId": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "description": "异步任务 ID，由创建任务接口返回。",
        "schema": {
          "type": "string",
          "example": "8fb5e33fbc9d4d4f9a9a9bbaf64f4c71"
        }
      }
    },
    "schemas": {
      "JobStatus": {
        "type": "string",
        "enum": ["pending", "running", "succeeded", "failed"],
        "description": "任务状态。pending=等待执行，running=执行中，succeeded=成功，failed=失败。"
      },
      "ImageDataType": {
        "type": "string",
        "enum": ["byte", "uint16"],
        "description": "输入图像数据类型，正式前端通常保持默认 byte。"
      },
      "SystemStatus": {
        "type": "object",
        "required": ["service", "status", "cuda_available", "cuda_device_count", "gpu_names", "default_model_profile"],
        "properties": {
          "service": {
            "type": "string",
            "enum": ["Geo-Core AI foreground mask API"]
          },
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "cuda_available": {
            "type": "boolean"
          },
          "cuda_device_count": {
            "type": "integer",
            "minimum": 0
          },
          "gpu_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memory": {
            "nullable": true,
            "$ref": "#/components/schemas/MemoryInfo"
          },
          "default_model_profile": {
            "type": "string",
            "default": "default"
          }
        }
      },
      "MemoryInfo": {
        "type": "object",
        "properties": {
          "total_gb": {
            "type": "number",
            "format": "float"
          },
          "available_gb": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": {
          "type": "number"
        }
      },
      "ForegroundMaskModelsResponse": {
        "type": "object",
        "required": ["models", "default_profile"],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "当前算法服务可构建的模型名称。"
          },
          "default_profile": {
            "type": "string",
            "description": "前端默认使用的模型 profile。"
          }
        }
      },
      "ForegroundMaskRequest": {
        "type": "object",
        "required": ["input_path"],
        "properties": {
          "input_path": {
            "type": "string",
            "description": "后端可访问的图像文件路径或目录路径。"
          },
          "output_dir": {
            "type": "string",
            "nullable": true,
            "description": "输出目录。为空时默认写入 api_runtime/outputs/{task_id}。"
          },
          "image_pattern": {
            "type": "string",
            "default": "*.tif",
            "description": "input_path 为目录时的文件匹配规则，例如 *.tif、*.png、*.jpg。"
          },
          "recursive": {
            "type": "boolean",
            "default": false,
            "description": "input_path 为目录时是否扫描子目录。"
          },
          "model_profile": {
            "type": "string",
            "default": "default",
            "description": "模型包 profile，正式前端通常保持 default。"
          },
          "model_package": {
            "type": "string",
            "nullable": true,
            "description": "显式模型包目录，正式前端通常不传。"
          },
          "threshold": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 1,
            "nullable": true,
            "description": "前景概率阈值。为空时使用模型包配置。"
          },
          "enable_postprocess": {
            "type": "boolean",
            "nullable": true,
            "description": "是否启用后处理。为空时使用模型包配置。"
          },
          "output_preview": {
            "type": "boolean",
            "default": true,
            "description": "是否输出 overlay.png 预览图。"
          },
          "model_name": {
            "type": "string",
            "nullable": true,
            "description": "兼容旧版临时模型加载方式，推荐前端不使用。"
          },
          "model_path": {
            "type": "string",
            "nullable": true,
            "description": "兼容旧版直接权重路径，推荐前端不使用。"
          },
          "num_classes": {
            "type": "integer",
            "minimum": 1,
            "default": 2
          },
          "band_num": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          },
          "label_norm": {
            "type": "boolean",
            "default": true
          },
          "train_list_path": {
            "type": "string",
            "nullable": true
          },
          "mean": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "number"
            }
          },
          "std": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "number"
            },
            "description": "如果传入 mean，std 长度必须与 mean 一致。"
          },
          "target_size": {
            "type": "integer",
            "minimum": 16,
            "default": 512
          },
          "unify_read_img": {
            "type": "boolean",
            "default": true
          },
          "overlap_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.8,
            "exclusiveMaximum": true,
            "default": 0.25
          },
          "ignore_bandnum": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "img_data_type": {
            "$ref": "#/components/schemas/ImageDataType"
          },
          "use_mask": {
            "type": "boolean",
            "default": false
          },
          "mask_path": {
            "type": "string",
            "nullable": true
          },
          "use_vsimem": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ForegroundMaskUploadRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "待识别图像文件。支持 jpg、jpeg、png、tif、tiff。"
          },
          "model_path": {
            "type": "string",
            "nullable": true
          },
          "model_profile": {
            "type": "string",
            "default": "default"
          },
          "model_package": {
            "type": "string",
            "nullable": true
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "nullable": true
          },
          "enable_postprocess": {
            "type": "boolean",
            "nullable": true
          },
          "output_preview": {
            "type": "boolean",
            "default": true
          },
          "model_name": {
            "type": "string",
            "default": "UNet"
          },
          "num_classes": {
            "type": "integer",
            "default": 2,
            "minimum": 1
          },
          "band_num": {
            "type": "integer",
            "default": 3,
            "minimum": 1
          },
          "mean": {
            "type": "string",
            "nullable": true,
            "description": "兼容旧版逗号分隔均值，例如 53.7,53.3,52.8。"
          },
          "std": {
            "type": "string",
            "nullable": true,
            "description": "兼容旧版逗号分隔标准差。"
          },
          "target_size": {
            "type": "integer",
            "default": 512,
            "minimum": 16
          },
          "overlap_rate": {
            "type": "number",
            "default": 0.25,
            "minimum": 0,
            "maximum": 0.8,
            "exclusiveMaximum": true
          },
          "img_data_type": {
            "$ref": "#/components/schemas/ImageDataType"
          }
        }
      },
      "TaskCreateResponse": {
        "type": "object",
        "required": ["task_id", "status", "status_url"],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "status_url": {
            "type": "string",
            "description": "任务状态查询路径。"
          }
        }
      },
      "TaskInfo": {
        "type": "object",
        "required": ["task_id", "status", "message", "input_paths", "output_files", "metrics", "warnings", "created_at", "updated_at"],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "message": {
            "type": "string"
          },
          "input_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_dir": {
            "type": "string",
            "nullable": true
          },
          "output_files": {
            "$ref": "#/components/schemas/OutputFiles"
          },
          "metrics": {
            "$ref": "#/components/schemas/TaskMetrics"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "任务失败时的错误信息。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OutputFiles": {
        "type": "object",
        "description": "输出文件路径。单图任务常见 key 为 mask_png、mask_tif、probability_tif、overlay_png、contours_json、metadata_json；批量任务 key 会加上图像名前缀，例如 sample1.mask_png。",
        "additionalProperties": {
          "type": "string"
