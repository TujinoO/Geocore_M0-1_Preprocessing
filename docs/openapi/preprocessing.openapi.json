          "box_id": {
            "type": "string"
          },
          "core_box_id": {
            "type": "string"
          },
          "order_index": {
            "type": "integer"
          },
          "depth_start_m": {
            "type": "number"
          },
          "depth_end_m": {
            "type": "number"
          },
          "bbox_xyxy_m1_input": {
            "$ref": "#/components/schemas/BBox"
          },
          "bbox_xyxy_rgb_reference": {
            "$ref": "#/components/schemas/BBox"
          },
          "angle_deg": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "corrected_image": {
            "type": "string"
          },
          "m1_1_mask": {
            "type": "string"
          },
          "transform_stack_ref": {
            "type": "string"
          },
          "m1_2": {
            "$ref": "#/components/schemas/M12Result"
          },
          "m1_3": {
            "$ref": "#/components/schemas/M13Result"
          },
          "segments_with_cube_refs": {
            "type": "string"
          }
        }
      },
      "M12Result": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string"
          },
          "input_image": {
            "type": "string"
          },
          "output_files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "M13Result": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "output_files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "PreprocessContext": {
        "type": "object",
        "required": ["schema_version", "fusion", "m1_1", "m1_2", "m1_3", "boxes"],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_dir": {
            "type": "string"
          },
          "fusion": {
            "$ref": "#/components/schemas/FusionContext"
          },
          "m1_1": {
            "$ref": "#/components/schemas/M11Context"
          },
          "m1_2": {
            "$ref": "#/components/schemas/M12Context"
          },
          "m1_3": {
            "$ref": "#/components/schemas/M13Context"
          },
          "boxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoreBoxSummary"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CoreSegment": {
        "type": "object",
        "required": ["segment_id", "core_box_id", "depth_start_m", "depth_end_m", "image_path", "mask_path", "cube_ref"],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "core_box_id": {
            "type": "string"
          },
          "hole_id": {
            "type": "string"
          },
          "depth_start_m": {
            "type": "number"
          },
          "depth_end_m": {
            "type": "number"
          },
          "depth_center_m": {
            "type": "number"
          },
          "length_cm": {
            "type": "number"
          },
          "image_path": {
            "type": "string"
          },
          "mask_path": {
            "type": "string"
          },
          "source_strip_bbox": {
            "$ref": "#/components/schemas/BBox"
          },
          "core_coverage_ratio": {
            "type": "number"
          },
          "missing_ratio": {
            "type": "number"
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grid": {
            "type": "string"
          },
          "cube_ref": {
            "$ref": "#/components/schemas/CubeRef"
          },
          "transform_stack_ref": {
            "type": "string"
          },
          "source_refs": {
            "type": "object",
            "additionalProperties": true
          },
          "bbox_corrected_box_estimate": {
            "$ref": "#/components/schemas/BBox"
          },
          "bbox_rgb_reference_parent_box": {
            "$ref": "#/components/schemas/BBox"
          },
          "band_selection": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SegmentPage": {
        "type": "object",
        "required": ["task_id", "items", "page", "page_size", "total"],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoreSegment"
            }
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "BBox": {
        "type": "array",
        "description": "Pixel bbox [x0, y0, x1, y1]. x1/y1 are exclusive unless explicitly documented otherwise.",
        "items": {
          "type": "integer"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "CancelJobRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "ReviewActionRequest": {
        "type": "object",
        "required": ["action_type", "target"],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": ["m1_1_box_review", "m1_2_mask_edit", "m1_3_depth_anchor_edit", "mark_needs_review", "mark_reviewed"]
          },
          "target": {
            "type": "object",
            "required": ["target_type", "target_id"],
            "properties": {
              "target_type": {
                "type": "string",
                "enum": ["job", "box", "mask", "segment", "depth_mapping"]
              },
              "target_id": {
                "type": "string"
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Action-specific payload. For mask edits include operation and regions."
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "ReviewActionResponse": {
        "type": "object",
        "required": ["review_id", "status", "accepted_at"],
        "properties": {
          "review_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "applied", "rejected"]
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "resulting_task_status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      }
    }
  }
}
