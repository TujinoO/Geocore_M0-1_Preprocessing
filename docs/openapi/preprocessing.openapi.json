          "output_dir": {
            "type": "string"
          }
        }
      },
      "M13Context": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string"
          },
          "depth_start_m": {
            "type": "number"
          },
          "depth_end_m": {
            "type": "number"
          }
        }
      },
      "CoreBoxSummary": {
        "type": "object",
        "required": ["box_id", "core_box_id", "corrected_image"],
